{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/canonical-review.schema.json",
  "$comment": "Copyright (c) 2026 Valency Systems Inc. Licensed under Apache-2.0.",
  "title": "Open Canonical Review Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "version",
    "created_at",
    "provenance",
    "target",
    "opinion"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system"
      ],
      "properties": {
        "source_system": {
          "type": "string"
        },
        "source_review_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "imported_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_payload": {
          "type": "object"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mapping_spec_id": {
              "type": "string"
            },
            "mapping_spec_version": {
              "type": "string"
            },
            "mapper_version": {
              "type": "string"
            },
            "lossiness_notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "referee": {
      "$ref": "#/$defs/referee"
    },
    "referees": {
      "type": "array",
      "minItems": 1,
      "description": "Array of referees for panel reviews or collaborative reviews. Use this instead of 'referee' when multiple reviewers are involved.",
      "items": {
        "$ref": "#/$defs/referee"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "work_type"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "description": "Primary identifier for the work being reviewed"
        },
        "identifiers": {
          "$ref": "#/$defs/workIdentifiers",
          "description": "Optional structured identifiers with validation and resolution metadata"
        },
        "work_type": {
          "type": "string",
          "enum": [
            "article",
            "preprint",
            "dataset",
            "software",
            "registered_report",
            "proposal",
            "other"
          ]
        },
        "version": {
          "type": "string",
          "description": "Version of the paper/work being reviewed (e.g., v1, v2)"
        },
        "venue": {
          "type": "string"
        },
        "track": {
          "type": "string"
        },
        "revision_of": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "review_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_type": {
          "type": "string",
          "enum": [
            "initial",
            "revision",
            "rebuttal_response",
            "meta_review",
            "shepherding",
            "post_publication",
            "replication"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "requested_by": {
          "type": "string"
        },
        "time_spent_hours": {
          "type": "number",
          "minimum": 0
        },
        "expertise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "self_reported_level": {
              "type": "string",
              "enum": [
                "expert",
                "knowledgeable",
                "somewhat_familiar",
                "not_familiar"
              ]
            },
            "domain_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "metric_catalog_ref": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/metricAssessment"
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": [
            "strong_accept",
            "accept",
            "weak_accept",
            "borderline",
            "weak_reject",
            "reject",
            "strong_reject",
            "revise",
            "major_revision",
            "minor_revision"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary_rationale": {
          "type": "string"
        }
      }
    },
    "opinion": {
      "$ref": "#/$defs/opinion"
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strengths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "required_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionItem"
          }
        },
        "optional_suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionItem"
          }
        }
      }
    },
    "claim_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimAssessment"
      }
    },
    "artifact_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactAssessment"
      }
    },
    "ethics_and_risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ethical_concerns": {
          "type": "boolean"
        },
        "concern_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "human_subjects",
              "privacy",
              "bias_fairness",
              "dual_use",
              "security",
              "environmental",
              "misinformation",
              "other"
            ]
          }
        },
        "notes": {
          "type": "string"
        },
        "required_mitigations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionItem"
          }
        }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "detailed_review": {
          "type": "string"
        },
        "author_questions": {
          "type": "string"
        },
        "confidential_to_editors": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer_leniency_z": {
          "type": "number"
        },
        "historical_accept_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "pgp",
              "did",
              "x509",
              "other"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    },
    "written_report": {
      "$ref": "#/$defs/writtenReport"
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["referee"] },
        { "required": ["referees"] }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "opinion": {
              "required": [
                "summary"
              ]
            }
          },
          "required": [
            "opinion"
          ]
        },
        {
          "properties": {
            "opinion": {
              "required": [
                "text"
              ]
            }
          },
          "required": [
            "opinion"
          ]
        },
        {
          "properties": {
            "findings": {
              "anyOf": [
                {
                  "required": [
                    "strengths"
                  ],
                  "properties": {
                    "strengths": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "weaknesses"
                  ],
                  "properties": {
                    "weaknesses": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "questions"
                  ],
                  "properties": {
                    "questions": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "identifierWithLink": {
      "type": "object",
      "additionalProperties": false,
      "description": "An identifier value with optional hyperlink for resolution",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "hyperlink": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "internalIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "description": "System-specific internal identifier with field name context",
      "required": ["field_name", "value"],
      "properties": {
        "field_name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the identifier field in the source system (e.g., 'DocumentID', 'hotcrp_pid', 'openreview_forum')"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "hyperlink": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "workIdentifiers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional structured identifiers for the work. Resolution priority: DOI > arXiv > S2CID > PubMed ID > PMCID > OpenAlex > permalink > internal_id",
      "properties": {
        "doi": {
          "type": "object",
          "additionalProperties": false,
          "description": "Digital Object Identifier (e.g., 10.1000/xyz-123)",
          "required": ["value"],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "^10\\.\\d{4,9}/[^\\s]+$"
            },
            "hyperlink": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "arxiv_id": {
          "type": "object",
          "additionalProperties": false,
          "description": "arXiv identifier (e.g., 2401.12345 or 2401.12345v2 or hep-th/9901001)",
          "required": ["value"],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(\\d{4}\\.\\d{4,5}(v\\d+)?|[a-z\\-]+/\\d{7})$"
            },
            "hyperlink": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "s2cid": {
          "$ref": "#/$defs/identifierWithLink",
          "description": "Semantic Scholar Corpus ID"
        },
        "pubmed_id": {
          "$ref": "#/$defs/identifierWithLink",
          "description": "PubMed ID (PMID)"
        },
        "pmcid": {
          "type": "object",
          "additionalProperties": false,
          "description": "PubMed Central ID (e.g., PMC5555555)",
          "required": ["value"],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "^PMC\\d+$"
            },
            "hyperlink": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "openalex_id": {
          "type": "object",
          "additionalProperties": false,
          "description": "OpenAlex Work ID (e.g., W2741809807)",
          "required": ["value"],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "^W\\d+$"
            },
            "hyperlink": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "permalink": {
          "type": "string",
          "format": "uri",
          "description": "Stable URL for the work"
        },
        "internal_id": {
          "$ref": "#/$defs/internalIdentifier",
          "description": "System-specific internal identifier"
        },
        "content_hash": {
          "type": "object",
          "additionalProperties": false,
          "description": "Content-addressed identifier for integrity verification",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": ["sha256", "sha512"]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "thirdPartyIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "description": "Generic third-party identifier with namespace",
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Namespace/type (e.g., 'scopus', 'researcherid', 'publons')"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aiRefereeReference": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lightweight reference to a third-party AI referee system when full provenance is not available",
      "required": ["third_party_id"],
      "properties": {
        "third_party_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier from the third-party AI review system (e.g., 'newco-ai-ref-2sd4f6a')"
        },
        "reference_url": {
          "type": "string",
          "format": "uri",
          "description": "URL for more information about the AI reviewer"
        },
        "display_name": {
          "type": "string",
          "description": "Human-readable name for the AI system"
        },
        "version": {
          "type": "string",
          "description": "Version of the AI reviewer (defaults to v1)"
        }
      }
    },
    "opinion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "stance": {
          "type": "string",
          "enum": [
            "positive",
            "mixed",
            "negative",
            "unclear"
          ]
        },
        "high_level_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "referee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referee_type",
        "identity_mode"
      ],
      "properties": {
        "referee_type": {
          "type": "string",
          "enum": [
            "human",
            "ai",
            "hybrid"
          ]
        },
        "identity_mode": {
          "type": "string",
          "enum": [
            "double_blind",
            "single_blind",
            "open",
            "pseudonymous",
            "confidential"
          ]
        },
        "referee_id": {
          "type": "string"
        },
        "competing_interests_declared": {
          "type": "boolean"
        },
        "competing_interests_statement": {
          "type": "string"
        },
        "human_referee": {
          "$ref": "#/$defs/humanReferee"
        },
        "ai_referee": {
          "$ref": "#/$defs/aiReferee"
        },
        "hybrid_workflow": {
          "$ref": "#/$defs/hybridWorkflow"
        },
        "reproducibility": {
          "$ref": "#/$defs/refereeReproducibility"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "referee_type": {
                "const": "human"
              }
            }
          },
          "then": {
            "required": [
              "human_referee"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referee_type": {
                "const": "ai"
              }
            }
          },
          "then": {
            "required": [
              "ai_referee"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referee_type": {
                "const": "hybrid"
              }
            }
          },
          "then": {
            "required": [
              "ai_referee",
              "hybrid_workflow"
            ]
          }
        }
      ]
    },
    "humanReferee": {
      "type": "object",
      "additionalProperties": false,
      "description": "Human referee identity and expertise information",
      "properties": {
        "orcid": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$",
          "description": "ORCID identifier (format: 0000-0000-0000-000X)"
        },
        "scopus_id": {
          "type": "string",
          "pattern": "^[1-9]\\d{9,11}$",
          "description": "Scopus Author ID (10-12 digits, no leading zero)"
        },
        "openalex_id": {
          "type": "string",
          "pattern": "^A\\d+$",
          "description": "OpenAlex Author ID (e.g., A5023888391)"
        },
        "google_scholar_id": {
          "type": "string",
          "pattern": "^[-_0-9A-Za-z]{12}$",
          "description": "Google Scholar profile ID (12 alphanumeric characters)"
        },
        "third_party_id": {
          "$ref": "#/$defs/thirdPartyIdentifier",
          "description": "Other identifier (publons, researcherid, etc.)"
        },
        "name": {
          "type": "string",
          "description": "Display name of the reviewer (may be redacted)"
        },
        "affiliation": {
          "type": "string",
          "description": "Institutional affiliation"
        },
        "expertise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "self_reported_level": {
              "type": "string",
              "enum": [
                "expert",
                "knowledgeable",
                "somewhat_familiar",
                "not_familiar"
              ]
            },
            "domain_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "affiliation_redacted": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "refereeReproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "seed"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "seed": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "determinism": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intended_deterministic": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "run_replay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "type": "string"
            },
            "replay_command": {
              "type": "string"
            },
            "config_ref": {
              "type": "string"
            },
            "bundle_ref": {
              "type": "string"
            },
            "bundle_hash": {
              "type": "string"
            }
          }
        },
        "environment_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "string"
            },
            "runtime": {
              "type": "string"
            },
            "container_image": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "aiReferee": {
      "type": "object",
      "additionalProperties": false,
      "description": "AI referee information - either full provenance or lightweight reference",
      "properties": {
        "system": {
          "$ref": "#/$defs/aiSystemProvenance"
        },
        "execution": {
          "$ref": "#/$defs/aiExecutionProvenance"
        },
        "inputs": {
          "$ref": "#/$defs/aiInputsProvenance"
        },
        "outputs": {
          "$ref": "#/$defs/aiOutputsProvenance"
        },
        "safety": {
          "$ref": "#/$defs/aiSafetyProvenance"
        },
        "reference": {
          "$ref": "#/$defs/aiRefereeReference",
          "description": "Lightweight reference to a third-party AI system"
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["system", "execution"],
          "properties": {
            "system": {
              "$ref": "#/$defs/aiSystemProvenance"
            },
            "execution": {
              "$ref": "#/$defs/aiExecutionProvenance"
            },
            "inputs": {
              "$ref": "#/$defs/aiInputsProvenance"
            },
            "outputs": {
              "$ref": "#/$defs/aiOutputsProvenance"
            },
            "safety": {
              "$ref": "#/$defs/aiSafetyProvenance"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["reference"],
          "properties": {
            "reference": {
              "$ref": "#/$defs/aiRefereeReference",
              "description": "Lightweight reference to a third-party AI system"
            }
          }
        }
      ]
    },
    "aiSystemProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critic_framework",
        "models"
      ],
      "properties": {
        "critic_framework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "build_id": {
              "type": "string"
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "organization": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            }
          }
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/aiModelSpec"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aiToolSpec"
          }
        },
